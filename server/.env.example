PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/freecall
# Frontend origins allowed to use the API, comma-separated
# e.g. http://localhost:5173,https://freecall.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Minutes an empty user-created room is kept before being removed
EMPTY_ROOM_TTL_MINUTES=5
# Optional TURN server (needed when users are behind strict NATs / firewalls)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
